{
	"name": "pi-extensions",
	"version": "1.0.0",
	"description": "Personal [pi](https://github.com/badlogic/pi) extensions bundle — coherent set of extensions used in my daily workflow.",
	"main": "index.js",
	"directories": {
		"doc": "doc",
		"test": "test"
	},
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check . && tsc -p github-write-approval/tsconfig.json --noEmit",
		"test": "node --test --test-concurrency=1 test/*.test.ts */test/*.test.ts",
		"test:fixtures": "node --test --test-concurrency=1 github-write-approval/test/command-policy.fixtures.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lajarre/pi-extensions.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/lajarre/pi-extensions/issues"
	},
	"homepage": "https://github.com/lajarre/pi-extensions#readme",
	"private": true,
	"type": "module",
	"dependencies": {
		"just-bash": "^2.11.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/node": "^24.10.0",
		"typescript": "^5.9.3"
	}
}
